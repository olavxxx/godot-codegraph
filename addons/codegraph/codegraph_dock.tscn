[gd_scene load_steps=2 format=3 uid="uid://b1codegraphdock"]

[ext_resource type="Script" path="res://addons/codegraph/codegraph_dock.gd" id="1_dock"]

[node name="CodeGraphDock" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_dock")

[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ModeOption" type="OptionButton" parent="Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="SearchInput" type="LineEdit" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Søk etter symbol, funksjon, klasse..."
clear_button_enabled = true

[node name="SearchButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "Søk"

[node name="VSeparator" type="VSeparator" parent="Toolbar"]
layout_mode = 2

[node name="HtmlButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "🌐 Visuell Graf"
tooltip_text = "Åpne det interaktive nodekartet i standard nettleser"

[node name="ReindexButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "🔄 Reindeks"
tooltip_text = "Tving fullstendig nybygging av indeksen"

[node name="StatusContainer" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="StatusLabel" type="Label" parent="StatusContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.75, 0.8, 1)
theme_override_font_sizes/font_size = 12
text = "CodeGraph klar. Velg modus og skriv søkeord."

[node name="OutputDisplay" type="RichTextLabel" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
focus_mode = 2
bbcode_enabled = true
selection_enabled = true
context_menu_enabled = true
